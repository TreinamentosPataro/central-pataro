# Copiar para .env.local. Nunca commitar, nunca colar em chat.

# Sem DATABASE_URL o painel usa um Postgres local (PGlite) em .dados/ — bom pra desenvolver.
# Com DATABASE_URL usa o Neon.
# DATABASE_URL=postgres://...neon.tech/central?sslmode=require

# Assina o cookie de sessão. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=

# Cifra CPF, RG e endereço (área restrita). Mesmo comando acima. Perder essa chave = perder esses dados.
COFRE_CHAVE=

# "dev" mostra a tela de entrar escolhendo o usuário (só no computador). Em produção: "google".
LOGIN_MODO=dev
